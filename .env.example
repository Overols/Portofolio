# Copy to .env.local for local dev, and set the same names in Vercel > Settings > Environment Variables.
# EmailVerify.io API key (app.emailverify.io > API)
EMAILVERIFY_API_KEY=
# Optional: true = let people download when the key is missing, credits ran out, or the API is down.
# Leave unset for strict mode (recommended).
# EMAILVERIFY_FAIL_OPEN=false
