# Copy to .env.local for local dev, and set the same names in Vercel > Settings > Environment Variables.
QEV_API_KEY=
# Optional: true = use QuickEmailVerification's free sandbox (simulated results, no credits used)
QEV_SANDBOX=false
# Optional: true = let unverifiable emails and API outages through. Leave unset for strict mode (recommended).
# QEV_FAIL_OPEN=false
